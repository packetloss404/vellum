# Copy to .env.production. The real file is excluded from Git and Docker builds.
ANTHROPIC_API_KEY=replace-me
VELLUM_API_TOKEN=replace-with-at-least-32-random-bytes

# Application host address exposed to the separate Caddy server.
VELLUM_BIND_ADDRESS=10.80.12.12
# Only this source IP (plus container-local loopback) may reach Nginx.
VELLUM_TRUSTED_PROXY_IP=10.80.13.11

