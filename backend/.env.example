ANTHROPIC_API_KEY=replace-me

VELLUM_DB_PATH=./vellum.db
VELLUM_HOST=127.0.0.1
VELLUM_MODEL=claude-opus-4-7
VELLUM_MODEL_ALT=claude-sonnet-4-6
VELLUM_INTAKE_MODEL=claude-sonnet-4-6
VELLUM_SUMMARY_MODEL=claude-haiku-4-5
VELLUM_SECTION_TOKEN_BUDGET=30000
VELLUM_LOOP_DETECTION_THRESHOLD=3
VELLUM_STUCK_SESSION_BUDGET_MULT=15
VELLUM_STUCK_REVISION_STALL_THRESHOLD=5
VELLUM_COMPACT_INPUT_TOKEN_THRESHOLD=80000
VELLUM_CONTEXT_MANAGEMENT_THRESHOLD=180000
VELLUM_TOOL_LOG_PATH=

# Optional local API guard. Empty token keeps localhost dev unchanged.
VELLUM_API_TOKEN=
VELLUM_API_AUTH_REQUIRED=false

# Hard agent run limits.
VELLUM_AGENT_MAX_TURNS=200
VELLUM_SUB_AGENT_MAX_TURNS=60
VELLUM_AGENT_MAX_CONCURRENT_RUNS=2

# Durable scheduler and crash-retry policy.
VELLUM_SCHEDULER_POLL_SECONDS=30
VELLUM_ERROR_RETRY_BASE_SECONDS=300
VELLUM_ERROR_RETRY_MAX=5
VELLUM_ERROR_RETRY_CAP_SECONDS=21600
